#@hotfix gcd_boxfilter_local 6ab102d30e97dfb5 82ccd27dc95a7024
# gcd_boxfilter_local and gcd_boxfilter_local_hp (include/andy_kelday.gmic) read the window size
# with 'i#1' at the current channel: with a reference image of fewer channels, the size is 0 on
# the others, and the output there NaN or -inf. https://github.com/NatronGitHub/openfx-gmic/issues/247. From the
# built-in standard library (the same in 4.0.8 and develop); fix: the reference's last channel
# for the channels it lacks, 'R=i(#1,x,y,z,min(c,s#1-1))'.
gcd_boxfilter_local : check ${"is_image_arg $1"}
pass$1 0 max. 1
repeat $!-1 l[$>,-1]
av={ia#0} sub.. $av cumulate.. xy
f.. "
begin(
const boundary=1;
const interpolation=1;
const W=w-1; const H=h-1;
T(X,Y)=Y>1?i(X,Y-1):Y*i(X,0);
B(X,Y)=Y<H?i(X,Y):(1+Y-H)*i(X,H)-(Y-H)*i(X,H-1);
D(X,Y)=X>1?T(X-1,Y):X*T(0,Y);
E(X,Y)=X<W?T(X,Y):(1+X-W)*T(W,Y)-(X-W)*T(W-1,Y);
F(X,Y)=X>1?B(X-1,Y):X*B(0,Y);
G(X,Y)=X<W?B(X,Y):(1+X-W)*B(W,Y)-(X-W)*B(W-1,Y);
);
R=i(#1,x,y,z,min(c,s#1-1)); S=R*R; K=(R-1)/2;
x0 = x - K;
y0 = y - K;
x1 = x + K;
y1 = y + K;
(G(x1,y1) - E(x1,y0) - F(x0,y1) + D(x0,y0))/S"
add.. $av
done done rm.

#@hotfix gcd_boxfilter_local_hp 1764a230cd7d6b89 5f0455e5e6b68350
# See gcd_boxfilter_local above.
gcd_boxfilter_local_hp : check ${"is_image_arg $1"}
pass$1 0 max. 1
repeat $!-1 l[$>,-1]
av={ia#0} sub.. $av
f.. "
begin(
const boundary=1;
ref(crop(#0),img);
const W=w-1; const H=h-1;
px(x,y) = (img[x + y*w#0 + c*wh#0]);
qx(x,y) = (
xA=floor(x);
xB=ceil(x);
yA=floor(y);
yB=ceil(y);
lx=x-xA;
lerp(
lerp(px(xA,yA),px(xB,yA),lx),
lerp(px(xA,yB),px(xB,yB),lx),
y-yA
)
);
T(X,Y)=Y>1?qx(X,Y-1):Y*qx(X,0);
B(X,Y)=Y<H?qx(X,Y):(1+Y-H)*qx(X,H)-(Y-H)*qx(X,H-1);
D(X,Y)=X>1?T(X-1,Y):X*T(0,Y);
E(X,Y)=X<W?T(X,Y):(1+X-W)*T(W,Y)-(X-W)*T(W-1,Y);
F(X,Y)=X>1?B(X-1,Y):X*B(0,Y);
G(X,Y)=X<W?B(X,Y):(1+X-W)*B(W,Y)-(X-W)*B(W-1,Y);
for (C = 0; P = 0, C<s#0, ++C,
for (X = 0; S = 0, X<w#0, ++X; ++P,
S += img[P];
img[P] = S;
);
for (Y = 1, Y<h#0, ++Y,
for (X = 0; S = 0, X<w#0, ++X; ++P,
S += img[P];
img[P] = img[P-w#0]+S;
)
)
)
);
R=i(#1,x,y,z,min(c,s#1-1)); S=R*R; K=(R-1)/2;
x0 = x - K;
y0 = y - K;
x1 = x + K;
y1 = y + K;
(G(x1,y1) - E(x1,y0) - F(x0,y1) + D(x0,y0))/S"
add.. $av
done done rm.
