#
#  File        : gmic_hotfixes.gmic
#                ( G'MIC custom commands, embedded into the openfx-gmic plug-in )
#
#  Description : Hot fixes for bugs in the G'MIC standard library and community filters,
#                until an upstream release fixes them. Each block below is a complete
#                command definition, copied from the G'MIC sources the plug-in is built
#                with, with a fix. The plug-in passes this file to G'MIC as custom commands
#                on every run: they are loaded after the built-in standard library, so each
#                definition replaces the built-in one, also when the command is called by
#                another one (e.g. rep_ncee from fx_ncee).
#
#  Format      : '#@hotfix <command> <original> <fixed> [<callee>:<checksum>...]' starts a
#                block, which ends at the next '#@hotfix' line. The checksums are FNV-1a
#                64-bit hashes of command definitions as G'MIC reads them (comments and
#                blank lines removed, lines trimmed, each followed by a newline): <original>
#                is the one of the built-in definition the fix was made from, and <fixed>
#                the one of the block's own (fixed) definition; <original> is '-' for a
#                command that the built-in G'MIC no longer defines, but that some of its
#                commands still call. The optional callees are
#                built-in commands that the fix relies on (e.g. one it calls instead of a
#                misspelt one), with their checksums. At load, the plug-in compares the
#                built-in definition of <command> with both ("if the fix is already there,
#                don't apply it"):
#                - it is <original> (for '-': there is none): the block is applied if
#                  every callee still has its checksum (the bug is still there, and the
#                  fix still fits);
#                - it is <fixed>: upstream has made the same fix, and the block is skipped
#                  silently (whatever the callees);
#                - anything else (or a callee changed or missing): the block is skipped with
#                  a warning giving the checksum found, on which the CI describe test fails.
#                  Review the fix against the new G'MIC sources: drop it if upstream fixed
#                  the bug in another way, otherwise update the definition and checksums.
#                The plug-in also warns, and skips the block, if <fixed> is not the checksum
#                of the block's definition (it was edited without updating its line).
#
#                The '#@openfx_gmic_hotfixes' line gives the G'MIC version (GMICVER in the
#                Makefile) these fixes were last reviewed against: the build warns (and
#                does not fail) for another version, since the checks above already find
#                every fix that needs a review. When bumping GMICVER, remove the blocks that
#                upstream has fixed (dead weight from then on), review the others if the
#                describe test warns, and update this version.
#
#@openfx_gmic_hotfixes 4.0.8

#@hotfix warp_perspective - 65fc5af1f0de72e0
# G'MIC 4.0.8 removed warp_perspective from its standard library (src/gmic_stdlib.gmic): only
# include/prawnsushi.gmic (gmic-community, CeCILL v2.0) still defines it, with the same code, so
# this block is skipped on GPL builds. COMMERCIAL builds leave prawnsushi.gmic out: this block
# restores the command there, for fx_warp_perspective below.
# From src/gmic_stdlib.gmic of G'MIC 4.0.7 (CeCILL-C / CeCILL v2.1), unchanged.
warp_perspective : skip ${1=1.5},${2=0},${3=1},${4=50},${5=50},${6=2}
  e[^-1] "Apply perspective warp to image$?, with angles ($1 deg.,$2 deg.), zoom $3 and offsets ($4,$5)."
  foreach {
    (0,100) -. $4 /. 100 (0;100) -. $5 /. 100 r[-2,-1] ...,...,...,1,3
    +*.. $2 +*.. $1 +[-2,-1] +. $3 /... . /[-2,-1]
    *.. 100 +.. $4 /.. 100 *.. {-3,w}
    *. 100 +. $5 /. 100 *. {-3,h}
    a[-2,-1] c warp.. .,0,1,$6 rm.
  }

#@hotfix fx_warp_perspective - ecff3251b9731b36
# G'MIC 4.0.8 replaced the filter Perspective (fx_warp_perspective) with a new one
# (fx_perspective), and removed fx_warp_perspective, which three filters of
# include/sylvie_alexandre.gmic (gmic-community) still call with their "Perspective - Param A"
# shape: Degrades HSL TSL (samj_Degrades_HSL_TSL), Formes Couleurs Variees Dans Image
# (samj_Formes_Couleurs_Variees_Dans_Image) and Motifs Degrades CIE (samj_Degrades_XYZ_CIE)
# fail with "Unknown command 'fx_warp_perspective'". Upstream: <URL>.
# From src/gmic_stdlib.gmic of G'MIC 4.0.7, unchanged. It calls warp_perspective, restored
# above when the built-in G'MIC doesn't define it (not listed as a callee: the block above
# checks it, and COMMERCIAL builds would otherwise leave this block out).
fx_warp_perspective :
  if !$8 to_a fi
  shift $6%,$7%,0,0,2 warp_perspective $1,$2,$3,$4,$5,$8

#@hotfix iain_hearttone 7daf14bce2e61fa6 0b96fcdd0f31d777
# Heart Tone and Star Tone fail on images that hold at most one tile ("Unknown command or
# filename '[-1]x0'"): the number of copies of the tile, '[-1]x{$total_tiles-1}', is then 0 (or -1
# if the image is smaller than half a tile, where 'round()' gives 0 tiles). Upstream disabled
# Halftone Shapes, which had the same bug (hidden in the plug-in), but not these two.
# https://github.com/GreycLab/gmic-community/issues/305.
# From include/iain_fergusson.gmic (gmic-community); fix: at least one tile per row and column,
# '{max(1,round(...))}', and 'if $total_tiles>1 [-1]x{$total_tiles-1} fi'.
iain_hearttone:

if $2>0
+iain_fast_denoise[0] $2,0,1,0,0
sub[1] [0]
mul[1] -1
add
n 0,255
fi
luminance
+l
rm
l
190,190,1,1,0
circle 50,50,50,1,10
circle 140,50,50,1,10
polygon 5,10,80,50,50,140,50,180,80,95,190,1,10
resize[-1] {0,w+2},{0,h+2},1,1,0,0,0.5,0.5

+resize[0] 95%,95%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 90%,90%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 85%,85%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 75%,75%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 65%,65%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 55%,55%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 50%,50%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 45%,45%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 40%,40%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 35%,35%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 30%,30%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 25%,25%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 20%,20%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 15%,15%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 10%,10%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
+resize[0] 5%,5%,1,1,2
resize[-1] {0,w},{0,h},1,1,0,0,0.5,0.5
add
done
[0]
append y
resize 200%,100%,1,1,0,0,0.5,0.5
+shift[0] 160,100,0,0
+shift[0] -160,100,0,0
add
crop 30,190,350,100%
n 0,255
done
resize[-1] $1,$1,1,1,2
width={w}
height={h}
w_tiles={0,max(1,round(w/$width))}
h_tiles={0,max(1,round(h/$height))}
total_tiles=$h_tiles*$w_tiles
if $total_tiles>1 [-1]x{$total_tiles-1} fi
append_tiles[1--1] $w_tiles,$h_tiles
## blur[-1] {5*($1/100)}
equalize[-1] 256
blend alpha,0.5,1
gt 128
mul 255

#@hotfix star_tone 58b60c1830114347 eca153bb2e65d8f0
# Star Tone: the same bug as Heart Tone above, and the same fix.
# https://github.com/GreycLab/gmic-community/issues/305.
# From include/iain_fergusson.gmic (gmic-community).
star_tone:
## points
sx1=50
sx2=194
sx3=281
sx4=511
sx5=742
sx6=829
sx7=972
sx8=829
sx9=742
sx10=511
sx11=281
sx12=192

sy1=450
sy2=633
sy3=849
sy4=817
sy5=849
sy6=633
sy7=450
sy8=267
sy9=50
sy10=83
sy11=50
sy12=267

level=10
luminance
+l
rm
2000,2000,1,1,0
repeat 8

polygon 12,$sx1,$sy1,$sx2,$sy2,$sx3,$sy3,$sx4,$sy4,$sx5,$sy5,$sx6,$sy6,$sx7,$sy7,$sx8,$sy8,$sx9,$sy9,$sx10,$sy10,$sx11,$sy11,$sx12,$sy12,1,$level

sx2={$sx2+40}
sx6={$sx6-40}
sx8={$sx8-40}
sx12={$sx12+40}

sy2={$sy2-23}
sy4={$sy4-47}
sy6={$sy6-23}
sy8={$sy8+23}
sy10={$sy10+47}
sy12={$sy12+23}

level={$level+25}

done
n 0,255
resize 200,200,1,1,3
+shift[0] -69,-40,0,0
+shift[0] -69,40,0,0
+shift[0] 69,-40,0,0
+shift[0] 69,40,0,0
add
 crop 5,5,142,84
done
resize[-1] $1,$1,1,1,2
width={w}
height={h}
w_tiles={0,max(1,round(w/$width))}
h_tiles={0,max(1,round(h/$height))}
total_tiles=$h_tiles*$w_tiles
if $total_tiles>1 [-1]x{$total_tiles-1} fi
append_tiles[1--1] $w_tiles,$h_tiles
## blur[-1] {5*($1/100)}
equalize[-1] 256
blend alpha,0.5,1
gt 128
mul 255
