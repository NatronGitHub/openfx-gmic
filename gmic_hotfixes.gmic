#
#  File        : gmic_hotfixes.gmic
#                ( G'MIC custom commands, embedded into the openfx-gmic plug-in )
#
#  Description : Hot fixes for bugs in the G'MIC standard library and community filters,
#                until an upstream release fixes them. Each block below is a complete
#                command definition, copied from the G'MIC sources the plug-in is built
#                with, with a fix. The plug-in passes this file to G'MIC as custom commands
#                on every run: they are loaded after the built-in standard library, so each
#                definition replaces the built-in one, also when the command is called by
#                another one (e.g. rep_ncee from fx_ncee).
#
#  Format      : '#@hotfix <command> <original> <fixed> [<callee>:<checksum>...]' starts a
#                block, which ends at the next '#@hotfix' line. The checksums are FNV-1a
#                64-bit hashes of command definitions as G'MIC reads them (comments and
#                blank lines removed, lines trimmed, each followed by a newline): <original>
#                is the one of the built-in definition the fix was made from, and <fixed>
#                the one of the block's own (fixed) definition. The optional callees are
#                built-in commands that the fix relies on (e.g. one it calls instead of a
#                misspelt one), with their checksums. At load, the plug-in compares the
#                built-in definition of <command> with both ("if the fix is already there,
#                don't apply it"):
#                - it is <original>: the block is applied if every callee still has its
#                  checksum (the bug is still there, and the fix still fits);
#                - it is <fixed>: upstream has made the same fix, and the block is skipped
#                  silently (whatever the callees);
#                - anything else (or a callee changed or missing): the block is skipped with
#                  a warning giving the checksum found, on which the CI describe test fails.
#                  Review the fix against the new G'MIC sources: drop it if upstream fixed
#                  the bug in another way, otherwise update the definition and checksums.
#                The plug-in also warns, and skips the block, if <fixed> is not the checksum
#                of the block's definition (it was edited without updating its line).
#
#                The '#@openfx_gmic_hotfixes' line gives the G'MIC version (GMICVER in the
#                Makefile) these fixes were last reviewed against: the build warns (and
#                does not fail) for another version, since the checks above already find
#                every fix that needs a review. When bumping GMICVER, remove the blocks that
#                upstream has fixed (dead weight from then on), review the others if the
#                describe test warns, and update this version.
#
#@openfx_gmic_hotfixes 4.0.7

#@hotfix denoise_patchpca b80cb9ad2b4df332 9c933f7616da9abf
# Smooth [Patch-PCA] (fx_smooth_patchpca) reads pY[k] out of bounds whenever every eigenvalue
# passes the threshold, so that k reaches size(pY): on a flat (e.g. black) image, where the
# noise estimate is 0, but also on smooth regions of natural images at a low strength, e.g.
# 'sp lena z 150,150,349,349 denoise_patchpca 0.5,5,7,3'.
# https://github.com/GreycLab/gmic/issues/219 (bug 2), NatronGitHub/openfx-gmic#41.
# From src/gmic_stdlib.gmic; fix: 'k<size(pY)?copy(...)'.
denoise_patchpca : check "${1=1.8} && $1>=0 && isint(${2=7},1) && isint(${3=11},1) && isint(${4=5},1)"
  e[^-1] "Denoise image$? using patch-pca, with strength $1, patch size $2, lookup size $3 and spatial sampling $4."
  foreach {
    nm={n} N2:=$2^2 M2:=$3^2 stdnoise=${-std_noise}
    100%,100%,1,100% => aggreg
    100%,100% => weights
    f[0] "*
    begin(
      n1 = int($2/2); n2 = $2 - n1 - 1;
      m1 = int($3/2); m2 = $3 - m1 - 1;
      patch(x,y) = crop(x - n1,y - n1,0,c,$2,$2,1,1,1);
      ngauss(x) = exp(-x*x/(2*n1*n1));
      zero = mask = vector"$N2"(0);
      for (l = 0; q = -n1, q<=n2, ++q,
        for (p = -n1, p<=n2, ++p, mask[l++] = ngauss(p)*ngauss(q)
        )
      )
    );

    if (!(x%$4) && !(y%$4), # Sub-sampling
      X = patch(x,y);

      # Build correlation matrix for PCA.
      M = vector"{$N2*$N2}"(0);
      for (q = -m1, q<=m2, ++q,
        for (p = -m1, p<=m2, ++p,
          Xk = patch(x + p,y + q) - X;
          M += mul(Xk,Xk,"$N2");
        )
      );
      M/="$M2";
      eig = eig(M);
      lambda = sqrt(abs(eig[0,"$N2"]));

      # Determine number of lambdas to keep and project neighboring patches.
      for (k = 0, k<size(lambda) && lambda[k]>=$1*"$stdnoise", ++k);
      Qt = eig["$N2","{$N2*$N2}"];
      Q = transpose(Qt,"$N2");
      for (q = -m1, q<=m2, ++q,
        for (p = -m1, p<=m2, ++p,
          pY = Qt*(patch(x + p,y + q) - X);
          k<size(pY)?copy(pY[k],zero[0],size(pY) - k);
          (Y = Q*pY)+=X;
          draw(#"$aggreg",Y,x + p - n1,y + q - n1,0,c,$2,$2,1,1,-1,mask);
          draw(#"$weights",mask,x + p - n1,y + q - n1,0,c,$2,$2,1,1,-1);
        )
      );
    0);0"
    max[weights] 0.01 /[aggreg,weights] k[aggreg] => $nm
  }

#@hotfix fx_recolorize 94bf1254223209cb fcdc583edbb2eb6f
# Colorize [Photographs] fails with two or more layers ("Unknown command '{'"): the local
# block is opened after 'rv[0,1]'.
# https://github.com/GreycLab/gmic/issues/220, NatronGitHub/openfx-gmic#53.
# From src/gmic_stdlib.gmic; fix: 'l[$s] { rv[0,1]'.
fx_recolorize :
  repeat int($!/2) {
    if $3 s:=$>,$>+1 else s:=2*$>,2*$>+1 fi
    l[$s] { rv[0,1]
      channels[0] 0 to_rgb.. # Convert to pure gray
      to_rgba. split_opacity. !=. 0 # Retrieve mask of color patches
      srgb2rgb[-3,-2] rgb2lab8[-3,-2] channels... 0 channels.. 1,2 # Now, list is [0]=lightness / [1]=chroma / [2]=mask
      +.. 1 *.. . +gradient_norm... *. -1 watershed... . rm. -.. 1 # Get first estimate for the color interpolation
      +diffusiontensors... $2,1,0.5,0.5 ==.. 0 *. .. rm..
      smooth.. .,{$1*80},0.8,60 rm.
      a[-2,-1] c lab82rgb. rgb2srgb.
      if $3 rgb2hsv. s. c i[2] 100%,100%,1,1,1 i[3] 100%,100%,1,2,0 a[0-2] c a[^0] c hsv2rgb rv fi
    }
  }

#@hotfix fx_rep_z_render c7fade49ea7684fb 9c29c9a18db02bb3 rep_z_render:24ea9b168818d76a
# Z-Time calls rep_r_render, which does not exist, instead of rep_z_render.
# https://github.com/GreycLab/gmic-community/issues/296, NatronGitHub/openfx-gmic#53.
# From include/reptorian.gmic (gmic-community); fix: 'rep_z_render'.
fx_rep_z_render :
  if $!<3 gui_error_preview "You need at least 3 images!"
  else rep_z_render $"*"
  fi

#@hotfix fx_ExposureWeightMap a3b06ac24194632a 15addf502cec120a Sub_BlurPyramid:5cbe9f072629234d
# Exposure Fusion Weight Map fails with Blur Map on: it calls sub_BlurPyramid, which is
# defined as Sub_BlurPyramid.
# https://github.com/GreycLab/gmic-community/issues/297, NatronGitHub/openfx-gmic#53.
# From include/arto_huotari.gmic (gmic-community); fix: 'Sub_BlurPyramid[0]'.
fx_ExposureWeightMap :
  wc=$1
  ws=$2
  sigma=$3
  we=$4
  BlurMap=$5
  to_rgb[0]
  +Sub_Contrast_Bias[0] # CB, 0,1
  +Sub_Saturation_Bias[0] # SB, 0,1,2
  +Sub_Exposure_Bias[0] $sigma # EB, 0,1,2,3
  rm[0] # 0,1,2
  # Weight W=CB^wc+SB^ws+EB^we
  ^[0] $wc
  ^[1] $ws
  ^[2] $we
  +[0] [1]
  +[0] [2]
  k[0]
  n[0] 0,255
  # Blur mask
  if $BlurMap==1
    Sub_BlurPyramid[0]
  fi

#@hotfix rep_ncee c3f584902340ae03 507c3c65c62c4cc3
# Non-Convolution Edge Extraction (fx_ncee) fails with the default RGB colour space
# ("Unknown command ''"): $convert_colors_fwd and $convert_colors_bwd are empty for RGB.
# https://github.com/GreycLab/gmic-community/issues/298, NatronGitHub/openfx-gmic#53.
# From include/reptorian.gmic (gmic-community); fix: 'if $7 $convert_colors_fwd fi', same for bwd.
rep_ncee:
skip ${3=3},${4=1},${5=1},${6=1},${7=0},${8=1},${9=1}

if $7 convert_colors_bwd,convert_colors_fwd=${rep_cs_arg\ 2,$7,,ryb,cmy,cmyk,hsi8,hsl8,hsv8,lab8,lch8,yiq8,yuv8,xyz8,yes8,k18,ohta8} fi

-command "MergeChoice : $""=_mode" -MergeChoice "add","alpha","and","average","blue","burn","darken","difference","divide","dodge","exclusion","freeze","grainextract","grainmerge","green","hardlight","hardmix","hue","interpolation","lighten","lightness","linearburn","linearlight","luminance","multiply","negation","or","overlay","pinlight","red","reflect","saturation","screen","shapeaverage","softburn","softdodge","softlight","stamp","subtract","value","vividlight","xor","edges","error"

to_a

split_opacity

local[0] {
 if $7 $convert_colors_fwd fi

 [0]

 local[1] {
  rep_dupsdaxy 2,$1,$2,0,$3,$4

  tci={$!}

  f. "255-i"

  add / $tci
  - 127.5
  * {2*$5}
  + 127.5

  cut 0,255

 }

 if $7!=3
  blend ${_mode{$8+1}},$9
  if $7 $convert_colors_bwd fi
 elif $7==3
  s c
  repeat 4 {
   local[$>,{$!-1}] {
    to_rgb
    blend ${_mode{$8+1}},$9
   }
  }
  a c
  cmyk2rgb
 fi
}

local[1] {
 if $6 rep_dupsdaxy 0,2,$1,$2,$3,$4 tai={$!} add / $tai fi
}
a c

#@hotfix fx_MorphoPaint 90ca886311780569 cb7c0f7cfa095868 fx_morphological:004391401d71bbbe
# Morphology Painting fails ("Unknown command '+fx_morpho[0]'"): fx_morpho no longer exists
# (it was already missing in G'MIC 2.8.4). The fix calls fx_morphological, whose arguments are
# action, kernel, size, custom kernel, negative, transparency, channels and value action.
# https://github.com/GreycLab/gmic-community/issues/299, NatronGitHub/openfx-gmic#53.
# From include/arto_huotari.gmic (gmic-community), as fixed upstream in bd6199e:
# '+fx_morphological[0] $1,$3,$2,0,0,0,0,0'.
fx_MorphoPaint :
  to_rgb[0]
  +fx_morphological[0] $1,$3,$2,0,0,0,0,0 # Morpho as nro 1
  +fx_apply_curve[1] $4,50,$5,200,$6,-1,128,-1,128,-1,128,255,1,3,0,0,0 # Curved morpho as nro 2
  fx_spread[1] $7,$7,0,0 # Spread Morpho nro 1
  fx_blur_gaussian[2] $8,0,0,1,0,0,0 # Blur Morpho+Spread nro 1
  fx_segment_watershed[1] $9,$10,0,0 # Segment Morpho+Spread+Blur nro 1
  +fx_painting[0] $11,$12,1.5,$13,1,0 # Paint from original nro 0
  rm[0] # Remove original from stack
  rv[0,2] # Reverse images to logical order (Important if output to Gimp)
  rv[1,2]
  if $14
    if $19==0 MorphoStrength={0} elif $19==1 MorphoStrength={$20} fi  # Set layer value to zero if enabled
    *[2] {$MorphoStrength/3} # Morphology
    if $15==0 StrokeStrength={0} elif $15==1 StrokeStrength={$16} fi  # Set layer value to zero if enabled
    *[0] {$StrokeStrength/3} # Paint stroke
    if $17==0 SegmentStrength={0} elif $17==1 SegmentStrength={$18} fi # Set layer value to zero if enabled
    *[1] {$SegmentStrength/3} # Segments
    +[1] [2] # Combine images
    +[1] [0]
    if $21 n[1] 0,255 fi # Conditional normalize to get the image to correct range
    rm[0,2] # Remove extra images
  fi

#@hotfix samj_Courtepointe 567ca51bc132cd23 50f5acb59e5cf698 fx_array_mirror:8beab7f0353a4ae1
# Random Pattern Courtepointe fails: it calls fx_array_mirror with 6 arguments, which now takes 7
# ("Undefined argument '$7'"), and its Color Curves choices call the interactive x_color_curves
# ("No display available" in a plug-in).
# https://github.com/GreycLab/gmic-community/issues/300, NatronGitHub/openfx-gmic#53.
# From include/sylvie_alexandre.gmic (gmic-community), as fixed upstream in 02618ee:
# 'fx_array_mirror[-1] 1,0,0,2,0,0,0', and the Color Curves choices numbered from 1, so that the
# default one (0, "RGB") applies no curves; the other choices still need a display. Upstream also
# changed the parameter to choice(0,"RGB",...), the same as G'MIC 4.0.7's choice("RGB",...).
# Copied verbatim from upstream, which shifts the Color Curves labels by one: "RGB" (0) applies
# no curves, "CMY" (1) runs the rgb curves, "CMYK" (2) the cmy ones, and so on up to "YCbCr" (8),
# which runs the lch ones: the ycbcr curves (9) are unreachable. Every non-zero choice still calls
# the interactive x_color_curves, and fails without a display.
samj_Courtepointe :

 Cossin=$1
 Cossin_Deux=$2
 Repetition=$3
 Croix=$4
 Texture=$5
 Courbes_Interactives_Couleurs=$6

 rorschach[-1] {$Cossin}%,1

 if $Cossin_Deux==1
  n[-1] 64,192
 fi

 n[-1] 0,255

 repeat $Repetition
  fx_array_mirror[-1] 1,0,0,2,0,0,0
 done

 if $Croix==1
  fx_symmetrizoscope[-1] 5,0,1,0
 fi

 if {$Texture==1}
  samj_Texture_Granuleuse[-1] 0.5,20,80,0,0
 fi

 if $Courbes_Interactives_Couleurs==1
  x_color_curves[-1] rgb
 elif $Courbes_Interactives_Couleurs==2
  x_color_curves[-1] cmy
 elif $Courbes_Interactives_Couleurs==3
  x_color_curves[-1] cmyk
 elif $Courbes_Interactives_Couleurs==4
  x_color_curves[-1] hsi
 elif $Courbes_Interactives_Couleurs==5
  x_color_curves[-1] hsl
 elif $Courbes_Interactives_Couleurs==6
  x_color_curves[-1] hsv
 elif $Courbes_Interactives_Couleurs==7
  x_color_curves[-1] lab
 elif $Courbes_Interactives_Couleurs==8
  x_color_curves[-1] lch
 elif $Courbes_Interactives_Couleurs==9
  x_color_curves[-1] ycbcr
 fi

#@hotfix jpr_line_edges 7ab9c05a08053286 fcb3832e40da19ea
# Jpr Line Edges outputs NaN pixels with Anti Alias on (the default): in flat areas, the shifted
# neighbour responses are both clamped to the threshold, and the anti-alias branch divides 0 by 0.
# https://github.com/GreycLab/gmic-community/issues/301, NatronGitHub/openfx-gmic#71.
# From include/james_prichard.gmic (gmic-community), as fixed upstream in 3c84adb:
# 'max. 1e-8' before each division.
jpr_line_edges : skip ${1=5},${2=5},${3=1},${4=1}
  e[^-1] "Find edges in image$? using $1 angles per quadrant with $2 blurring and $3 anti-alias"
  repeat $! l[$>]
    norm           # simple convert to grayscale
    fft            # re. [0] im. [1]
    100%,100%,1,1,x-w/2 # [2] x
    100%,100%,1,1,y-h/2 # [3] y
    shift[2,3] {-round(w/2)},{-round(h/2)},0,0,2
    100%,100%,1,1   # [4] accumulator
    repeat $1 # an even number of angles avoids exact horizontal and allows mirroring
      ac={3*cos(($>+0.5)*pi/$1/2)/sqrt(pi)*$2/w}
      as={3*sin(($>+0.5)*pi/$1/2)/sqrt(pi)*$2/w}
      +*[2] $ac      # make an oriented filter for convolution like blur_linear
      +*[3] $as      # quicker using x and y images in steps than filling one linear formula
      +[-2,-1]       # filter : D = $ac*dx+$as*dy ; D * exp ( -D*D )
      +sqr.
      *. -1
      exp.
      *[-2,-1]       # fourier filter of derivative operator is ix
      +mirror. x  # angles in the other quadrant are reflections
      *. -1       # negate because reflection had inverted the sign of D
      [1]x1
      *. -1       # re = i x im
      [0]x1           # im = re
      *[-2,-1] [-4]  # filter blur + derivative
      rm[-4]
      ifft[-2,-1]
      rm.         # imaginary component after inverting should be zero
      [1]x1           # process mirror the same way
      *. -1
      [0]x1
      *[-2,-1] [-4]
      rm[-4]
      ifft[-2,-1]
      rm.         # [0,1] fft [2,3] xy [4] acc .. [-2] gradient [-1] mirror
      abs[-2,-1]     # detect lines using max of abs(gradient)
      max[-2,-1] $3  # de-minimis gradient threshold
      ac={round(1.45*cos(($>+0.5)*pi/$1/2))} # pixel offset
      as={round(1.45*sin(($>+0.5)*pi/$1/2))}
      +shift.. {-$ac},{-$as} # offsets to align neighbours
      +shift... {$ac},{$as}
      +shift... {$ac},{-$as}  # mirror the offsets for mirrored orientation
      +shift[-4] {-$ac},{$as}
      # [-6,-4,-3] gradient and neighbours [-5,-2,-1] mirror and neighbours
      if $4 # anti-alias using heuristic 2*max( 0 , ( i - avg )/( max - min ) - 0.1 ) adaptive weights
        +max[-6,-4,-3]  #           +1
        +min[-7,-5,-4]  #           +1
        -[-2,-1]        # max-min   -1
        +[-5,-4]        #           -1
        *[-4] 0.5       # avg
        -[-6,-4]        # i - avg   -1
        max. 1e-8
        /[-5,-1]        #           -1
        -[-4] 0.1
        max[-4] 0
        *[-4] 2
        -[4,-4]         #           -1
        +max[-3,-2,-1]  #           +1
        +min[-4,-3,-2]  #           +1
        -[-2,-1]        # max-min   -1
        +[-3,-2]        #           -1
        *.. 0.5       # avg
        -[-3,-2]        # i - avg   -1
        max. 1e-8
        /[-2,-1]        #           -1
        -. 0.1
        max. 0
        *. 2
        -[4,-1]         #           -1
      else   # without anti-alias require local maximum i > .-. && i > .+. neighbours
        max[-4,-3]
        gt[-5,-3]
        -[4,-4]
        max[-2,-1]
        gt[-2,-1]
        -[4,-1]
      fi
    done
    rm[0,1,2,3]
    n 0,255
  done done

#@hotfix afre_gleam 791799a25ffe36cc 227c91cfd56db930 split_opacity:25788a9c72def3ee
# Gleam fails on images with alpha ("Command 'softlight': Select image(s) with 1 or 3
# channels"): afre_softlight rejects RGBA. The fix processes the colour channels only.
# https://github.com/GreycLab/gmic-community/issues/302.
# From include/afre.gmic (gmic-community), as fixed upstream in b39d2b1:
# 'foreach { split_opacity l[0] { ... } a c }'.
afre_gleam : check "${1=3}>=2 && ${2=50}>=10 && $1<=100 && $2<=90"
  e[] "[afre]^_^) gleam: Add gleam effect to image$? using smooth=$1 and threshold=$2."
  foreach { split_opacity
    l[0] { +afre_y50 1 >. {100-$2}% b. $1% sqrt. +afre_softlight 100 rm.. max }
    a c
  }
