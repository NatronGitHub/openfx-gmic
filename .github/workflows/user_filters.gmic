# Filters for user_filters_test.py: a user filter file (~/.config/gmic/gmic_ofx.gmic) whose
# filters call commands that the file defines (#168), a built-in command, and a built-in command
# that the file replaces, two that need the state of their preview command (#206), and two with
# push buttons (#174); it also defines a command that the plug-in hot-fixes.
#@gui User File Test
#@gui User File Own Command : fx_userfile_own, fx_userfile_own
#@gui : Value = float(0.25,0,1)
fx_userfile_own :
  _fx_userfile_own_fill {$1*255}

_fx_userfile_own_fill :
  f $1

#@gui User File Builtin Command : fx_userfile_builtin, fx_userfile_builtin
#@gui : Value = float(0.5,0,1)
fx_userfile_builtin :
  fill_color {$1*255},0,255

#@gui User File Override : fx_userfile_override, fx_userfile_override
fx_userfile_override :
  fc 10,20,30

# fills the image with G'MIC's $_cpus, the thread count that the plug-in sets (#188)
#@gui User File Cpus : fx_userfile_cpus, fx_userfile_cpus
fx_userfile_cpus :
  f {$_cpus}

# need the state that their preview command leaves (#206): the plug-in runs the preview command
# first, as G'MIC-Qt's Apply follows a preview, then the main command with the preview's
# _persistent and the values that the preview's status gives the parameters. The preview's own
# result (magenta) is discarded.
# - User File Persistent: _persistent is a string (0.75: red), read in a command that the main
#   command calls; the status "{0.5}{3}" gives Value (green 0.5) and Steps (blue 0.3), past a
#   note and a separator, which are no arguments.
# - User File Persistent Store: _persistent is an image (0.25,0.5,0.75), stored with 'store'.
#@gui User File Persistent : fx_userfile_persistent, fx_userfile_persistent_preview
#@gui : note = note("The preview command sets the state.")
#@gui : Value = float(0.25,0,1)
#@gui : sep = separator()
#@gui : Steps = int(1,0,10)
fx_userfile_persistent :
  _fx_userfile_persistent_fill $1,$2

_fx_userfile_persistent_fill :
  if !narg($_persistent) error "No state from the preview command" fi
  fill_color {$_persistent*255},{$1*255},{$2*25.5}

# (skip: a command that names no argument doesn't take its arguments, which G'MIC would then
# read as the next item, here a file name)
fx_userfile_persistent_preview :
  skip $*
  _persistent=0.75
  fill_color 255,0,255
  u "{0.5}{3}"

#@gui User File Persistent Store : fx_userfile_persistent_store, fx_userfile_persistent_store_preview
fx_userfile_persistent_store :
  if !narg($_persistent) error "No stored state from the preview command" fi
  $_persistent
  fill_color[0] {-1,i[0]*255},{-1,i[1]*255},{-1,i[2]*255}
  rm.

fx_userfile_persistent_store_preview :
  (0.25,0.5,0.75) +store. _persistent rm.
  fill_color 255,0,255

# fills the image with what the plug-in gives G'MIC on every run, as G'MIC-Qt does (#206): R is 255
# if $_host is ofx, G is 10*$_input_layers+$_output_mode (10: Source only, and _output_mode is 0
# in every Output Layer mode), B is 255 if the input's layer name (pos(0,0),name(Source)) is Source
#@gui User File Run Variables : fx_userfile_vars, fx_userfile_vars
fx_userfile_vars :
  nm=${-gui_layer_name}
  fill_color {same('$_host','ofx')*255},{10*0$_input_layers+0$_output_mode},{same('$nm','Source')*255}

# buttons (#174): push buttons, which renders get 0 for, as G'MIC-Qt's Apply (it follows the
# preview that the click made, after which the button is 0 again). Pressing one runs the preview
# command once with 1 for it, and the parameters get the values that the run's status gives.
# - User File Button: the status sets a value of each type (Level: red 0.75, Steps: blue 0.4,
#   past a separator); the render's green is the button, always 0. Without a press, the preview
#   sets no status, and the values stay (red 0.25, blue 0.1).
# - User File Status Visibility: the status hides Hidden Level ("_0") and sets it to 0.6 (red).
#   The visibility is not applied yet (#173): Hidden Level stays visible, as in every filter that
#   sets visibilities at run time (#170).
#@gui User File Button : fx_userfile_button, fx_userfile_button_preview
#@gui : Level = float(0.25,0,1)
#@gui : Press = button()
#@gui : sep = separator()
#@gui : Steps = int(1,0,10)
#@gui : Mode = choice("A","B","C")
#@gui : Flag = bool(0)
#@gui : Tint = color(10,20,30)
#@gui : Spot = point(25,75)
#@gui : Label = text("before")
fx_userfile_button :
  fill_color {$1*255},{$2*255},{$3*25.5}

fx_userfile_button_preview :
  if $2 u "{0.75}{0}{4}{2}{1}{40,50,60}{60,40}{after}" fi
  fill_color 255,0,255

#@gui User File Status Visibility : fx_userfile_visibility, fx_userfile_visibility_preview
#@gui : Hidden Level = float(0.2,0,1)
#@gui : Hide = button()
fx_userfile_visibility :
  fill_color {$1*255},{$2*255},0

fx_userfile_visibility_preview :
  if $2 u "{0.6}_0{0}" fi
  fill_color 255,0,255

# a result with 5 channels, which fails the render as in G'MIC-Qt (#206)
#@gui User File Five Channels : fx_userfile_five_channels, fx_userfile_five_channels
fx_userfile_five_channels :
  r 100%,100%,1,5

# replaces the built-in 'fc' (fill_color)
fc :
  f 128

# a definition of its own of a command that the plug-in hot-fixes (gmic_hotfixes.gmic): it is
# kept, with a note (no filter here calls it)
star_tone :
  f 0
