# Filters for user_filters_test.py: a user filter file (~/.config/gmic/gmic_ofx.gmic) whose
# filters call commands that the file defines (#168), a built-in command, and a built-in command
# that the file replaces, and two that need the state of their preview command (#206); it also
# defines a command that the plug-in hot-fixes.
#@gui User File Test
#@gui User File Own Command : fx_userfile_own, fx_userfile_own
#@gui : Value = float(0.25,0,1)
fx_userfile_own :
  _fx_userfile_own_fill {$1*255}

_fx_userfile_own_fill :
  f $1

#@gui User File Builtin Command : fx_userfile_builtin, fx_userfile_builtin
#@gui : Value = float(0.5,0,1)
fx_userfile_builtin :
  fill_color {$1*255},0,255

#@gui User File Override : fx_userfile_override, fx_userfile_override
fx_userfile_override :
  fc 10,20,30

# fills the image with G'MIC's $_cpus, the thread count that the plug-in sets (#188)
#@gui User File Cpus : fx_userfile_cpus, fx_userfile_cpus
fx_userfile_cpus :
  f {$_cpus}

# need the state that their preview command leaves (#206): the plug-in runs the preview command
# first, as G'MIC-Qt's Apply follows a preview, then the main command with the preview's
# _persistent and the values that the preview's status gives the parameters. The preview's own
# result (magenta) is discarded.
# - User File Persistent: _persistent is a string (0.75: red), read in a command that the main
#   command calls; the status "{0.5}{3}" gives Value (green 0.5) and Steps (blue 0.3), past a
#   note and a separator, which are no arguments.
# - User File Persistent Store: _persistent is an image (0.25,0.5,0.75), stored with 'store'.
#@gui User File Persistent : fx_userfile_persistent, fx_userfile_persistent_preview
#@gui : note = note("The preview command sets the state.")
#@gui : Value = float(0.25,0,1)
#@gui : sep = separator()
#@gui : Steps = int(1,0,10)
fx_userfile_persistent :
  _fx_userfile_persistent_fill $1,$2

_fx_userfile_persistent_fill :
  if !narg($_persistent) error "No state from the preview command" fi
  fill_color {$_persistent*255},{$1*255},{$2*25.5}

# (skip: a command that names no argument doesn't take its arguments, which G'MIC would then
# read as the next item, here a file name)
fx_userfile_persistent_preview :
  skip $*
  _persistent=0.75
  fill_color 255,0,255
  u "{0.5}{3}"

#@gui User File Persistent Store : fx_userfile_persistent_store, fx_userfile_persistent_store_preview
fx_userfile_persistent_store :
  if !narg($_persistent) error "No stored state from the preview command" fi
  $_persistent
  fill_color[0] {-1,i[0]*255},{-1,i[1]*255},{-1,i[2]*255}
  rm.

fx_userfile_persistent_store_preview :
  (0.25,0.5,0.75) +store. _persistent rm.
  fill_color 255,0,255

# replaces the built-in 'fc' (fill_color)
fc :
  f 128

# a definition of its own of a command that the plug-in hot-fixes (gmic_hotfixes.gmic): it is
# kept, with a note (no filter here calls it)
star_tone :
  f 0
