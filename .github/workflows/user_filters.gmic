# Filters for user_filters_test.py: a user filter file (~/.config/gmic/gmic_ofx.gmic) whose
# filters call commands that the file defines (#168), a built-in command, and a built-in command
# that the file replaces; it also defines a command that the plug-in hot-fixes.
#@gui User File Test
#@gui User File Own Command : fx_userfile_own, fx_userfile_own
#@gui : Value = float(0.25,0,1)
fx_userfile_own :
  _fx_userfile_own_fill {$1*255}

_fx_userfile_own_fill :
  f $1

#@gui User File Builtin Command : fx_userfile_builtin, fx_userfile_builtin
#@gui : Value = float(0.5,0,1)
fx_userfile_builtin :
  fill_color {$1*255},0,255

#@gui User File Override : fx_userfile_override, fx_userfile_override
fx_userfile_override :
  fc 10,20,30

# fills the image with G'MIC's $_cpus, the thread count that the plug-in sets (#188)
#@gui User File Cpus : fx_userfile_cpus, fx_userfile_cpus
fx_userfile_cpus :
  f {$_cpus}

# fills the image with what the plug-in gives G'MIC on every run, as G'MIC-Qt does (#206): R is 255
# if $_host is ofx, G is 10*$_input_layers+$_output_mode (10 with Source only and Output Layer
# Merged), B is 255 if the input's layer name (pos(0,0),name(Source)) is Source
#@gui User File Run Variables : fx_userfile_vars, fx_userfile_vars
fx_userfile_vars :
  nm=${-gui_layer_name}
  fill_color {same('$_host','ofx')*255},{10*0$_input_layers+0$_output_mode},{same('$nm','Source')*255}

# a result with 5 channels, which fails the render as in G'MIC-Qt (#206)
#@gui User File Five Channels : fx_userfile_five_channels, fx_userfile_five_channels
fx_userfile_five_channels :
  r 100%,100%,1,5

# replaces the built-in 'fc' (fill_color)
fc :
  f 128

# a definition of its own of a command that the plug-in hot-fixes (gmic_hotfixes.gmic): it is
# kept, with a note (no filter here calls it)
star_tone :
  f 0
