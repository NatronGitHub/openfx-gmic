# Filters for user_filters_test.py: a user filter file (~/.config/gmic/gmic_ofx.gmic) whose
# filters call commands that the file defines (#168), a built-in command, and a built-in command
# that the file replaces, and two that need the state of their preview command (#206); it also
# defines a command that the plug-in hot-fixes.
#@gui User File Test
#@gui User File Own Command : fx_userfile_own, fx_userfile_own
#@gui : Value = float(0.25,0,1)
fx_userfile_own :
  _fx_userfile_own_fill {$1*255}

_fx_userfile_own_fill :
  f $1

#@gui User File Builtin Command : fx_userfile_builtin, fx_userfile_builtin
#@gui : Value = float(0.5,0,1)
fx_userfile_builtin :
  fill_color {$1*255},0,255

#@gui User File Override : fx_userfile_override, fx_userfile_override
fx_userfile_override :
  fc 10,20,30

# fills the image with G'MIC's $_cpus, the thread count that the plug-in sets (#188)
#@gui User File Cpus : fx_userfile_cpus, fx_userfile_cpus
fx_userfile_cpus :
  f {$_cpus}

# need the state that their preview command leaves (#206): the plug-in runs the preview command
# first, as G'MIC-Qt's Apply follows a preview, then the main command with the preview's
# _persistent and the values that the preview's status gives the parameters. The preview's own
# result (magenta) is discarded.
# - User File Persistent: _persistent is a string (0.75: red), read in a command that the main
#   command calls; the status "{0.5}{3}" gives Value (green 0.5) and Steps (blue 0.3), past a
#   note and a separator, which are no arguments.
# - User File Persistent Store: _persistent is an image (0.25,0.5,0.75), stored with 'store'.
#@gui User File Persistent : fx_userfile_persistent, fx_userfile_persistent_preview
#@gui : note = note("The preview command sets the state.")
#@gui : Value = float(0.25,0,1)
#@gui : sep = separator()
#@gui : Steps = int(1,0,10)
fx_userfile_persistent :
  _fx_userfile_persistent_fill $1,$2

_fx_userfile_persistent_fill :
  if !narg($_persistent) error "No state from the preview command" fi
  fill_color {$_persistent*255},{$1*255},{$2*25.5}

# (skip: a command that names no argument doesn't take its arguments, which G'MIC would then
# read as the next item, here a file name)
fx_userfile_persistent_preview :
  skip $*
  _persistent=0.75
  fill_color 255,0,255
  u "{0.5}{3}"

#@gui User File Persistent Store : fx_userfile_persistent_store, fx_userfile_persistent_store_preview
fx_userfile_persistent_store :
  if !narg($_persistent) error "No stored state from the preview command" fi
  $_persistent
  fill_color[0] {-1,i[0]*255},{-1,i[1]*255},{-1,i[2]*255}
  rm.

fx_userfile_persistent_store_preview :
  (0.25,0.5,0.75) +store. _persistent rm.
  fill_color 255,0,255

# fills the image with what the plug-in gives G'MIC on every run, as G'MIC-Qt does (#206): R is 255
# if $_host is ofx, G is 10*$_input_layers+$_output_mode (10: Source only, and _output_mode is 0
# in every Output Layer mode), B is 255 if the input's layer name (pos(0,0),name(Source)) is Source
#@gui User File Run Variables : fx_userfile_vars, fx_userfile_vars
fx_userfile_vars :
  nm=${-gui_layer_name}
  fill_color {same('$_host','ofx')*255},{10*0$_input_layers+0$_output_mode},{same('$nm','Source')*255}

# a result with 5 channels, which fails the render as in G'MIC-Qt (#206)
#@gui User File Five Channels : fx_userfile_five_channels, fx_userfile_five_channels
fx_userfile_five_channels :
  r 100%,100%,1,5

# a filter whose preview factor ends with "+" (accurate at any zoom), so that Natron may render it
# at a render scale (#179), rendered by user_filters_test.py at render scales 1 and 0.5: R and G
# are the x and y percentages of the Spot point that G'MIC gets (from the point's canonical
# coordinates, the render scale and the pixel aspect ratio), B is 255 if the preview area
# ($_preview_x1, $_preview_y1) ends at the image's last column and row
#@gui User File Render Scale : fx_userfile_render_scale, fx_userfile_render_scale(0)+
#@gui : Spot = point(50,50)
fx_userfile_render_scale :
  fill_color {$1*2.55},{$2*2.55},{(0$_preview_x1+1==w&&0$_preview_y1+1==h)*255}

# replaces the built-in 'fc' (fill_color)
fc :
  f 128

# a definition of its own of a command that the plug-in hot-fixes (gmic_hotfixes.gmic): it is
# kept, with a note (no filter here calls it)
star_tone :
  f 0

# results of another size and position (#175), uniform opaque colours: with Resize Mode Dynamic
# (the default), the output has the result's size and position, which the region of definition
# declares: larger (200% x 150%), smaller (50% x 25%), and moved by the pos(10,20) of its name (10
# pixels right and 20 down, as G'MIC-Qt's hosts place a layer)
#@gui User File Larger : fx_userfile_larger, fx_userfile_larger
fx_userfile_larger :
  r 200%,150%,1,100%,0 fill_color 255,0,0,255

#@gui User File Smaller : fx_userfile_smaller, fx_userfile_smaller
fx_userfile_smaller :
  r 50%,25%,1,100%,0 fill_color 0,255,0,255

#@gui User File Shifted : fx_userfile_shifted, fx_userfile_shifted
fx_userfile_shifted :
  fill_color 0,0,255,255 nm "pos(10,20),name(Source)"

# a size that depends on the pixels: 80 pixels wide if the pixel at (80,60) is red (in the red
# rectangle of the test's input), else 40 (the plug-in's small probe images, gradients, which are
# never red there), 60 high. The region of definition gets the probes' size, so the render warns
# and crops.
#@gui User File Content Size : fx_userfile_content_size, fx_userfile_content_size
fx_userfile_content_size :
  w2={i(80,60,0,0)>200&&i(80,60,0,1)<100?80:40} r $w2,60,1,100%,0 fill_color 255,255,0,255

# a size that is not an affine function of the input's: sqrt(W*H) wide. The fits fail, and the
# plug-in confirms the size with one probe at full size (rendered on the test's small Source, which
# is probed at its own size anyway, and on a 1920x1080 Source)
#@gui User File Area Size : fx_userfile_area_size, fx_userfile_area_size
fx_userfile_area_size :
  r {round(sqrt(w*h))},100%,1,100%,0 fill_color 0,255,255,255

# two results, for Output Layer "Frame": frame 0 is [0], half of Source's size at pos(5,6), frame
# 1 is [1], Source's size
#@gui User File Frames : fx_userfile_frames, fx_userfile_frames
fx_userfile_frames :
  fill_color 255,0,255,255 +r[0] 50%,50%,1,100%,0 rv nm[0] "pos(5,6),name(Small)"

# a rotation: its size, round(1 + |cos|*(W-1) + |sin|*(H-1)) wide (CImg's get_rotate), is affine
# but irrational, which the small probes can't predict at a large size: the plug-in refines it
# with two thin probes, within a pixel, and adds a 1-pixel margin (rendered on a 1920x1080 Source)
#@gui User File Rotate : fx_userfile_rotate, fx_userfile_rotate
#@gui : Angle = float(30,0,90)
fx_userfile_rotate :
  rotate $1,1,0 fill_color 255,128,0,255

# a frame in percent of max(w,h), rounded, as Frame [Regular] (10% of the long side, and a
# 1-pixel outline): affine only over probes of Source's proportions, so the refinement fails and
# the plug-in confirms the size with one probe at full size (rendered on a 1920x1080 Source)
#@gui User File Frame Max : fx_userfile_frame_max, fx_userfile_frame_max
fx_userfile_frame_max :
  fs={round(0.1*max(w+2,h+2))} r {w+2+2*$fs},{h+2+2*$fs},1,100%,0 fill_color 0,128,255,255

# a size in percent that is no exact fraction (10%, 70%): refined with thin probes, with a margin
# (rendered on a 1920x1080 Source)
#@gui User File Percent : fx_userfile_percent, fx_userfile_percent
#@gui : Percent = float(10,1,200)
fx_userfile_percent :
  r $1%,$1%,1,100%,0 fill_color 128,0,255,255
