fx_userfile_status :
  fill_color {$2*255},{$3*255},{$4*25.5}

fx_userfile_status_preview :
  if $1 u "{"$1"}{"$2"}_2{"$2"}_2{7}" else u "{"$1"}{"$2"}{"$3"}{"$4"}" fi
  fill_color 255,0,255
